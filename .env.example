# Copy to .env for local use. On Render, enter these in Environment settings.
# NEVER commit the real .env.

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=nestuser
DB_PASS=nestpassword
DB_NAME=nestjs_db
# Set to true for cloud MySQL (Aiven / TiDB Cloud require TLS)
DB_SSL=false
MYSQL_ROOT_PASSWORD=rootpassword

# --- Auth ---
# Use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change_me
JWT_EXPIRATION=3600s

# --- Mail (Gmail needs an App Password) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM="CRM App <no-reply@yourcrm.com>"

# --- Frontend URL(s) ---
# Used for CORS and password-reset links. Comma-separate multiple; first is used in emails.
FRONTEND_URL=http://localhost:3001
